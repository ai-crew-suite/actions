{
  "name": "@ai-crew-suite/action-eslint-config-sync",
  "description": "GitHub Action to sync ESLint configuration",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license third-party-licenses.txt",
    "clean": "rm -rf dist third-party-licenses.txt",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"package.json\"",
    "lint": "lint:actions && lint:typescript",
    "lint:actions": "FORCE_COLOR=1 npx node-actionlint",
    "lint:typescript": "eslint src/**/*.ts",
    "test": "yarn test:unit",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "typecheck": "turbo typecheck",
    "typecheck:full": "turbo typecheck --force"
  },
  "dependencies": {
    "@actions/core": "catalog:prod:",
    "@actions/github": "catalog:prod:"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@vercel/ncc": "catalog:dev",
    "eslint": "catalog:dev",
    "node-actionlint": "catalog:dev",
    "prettier": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
