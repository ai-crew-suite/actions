{
  "name": "actions",
  "description": "GitHub Actions package for the AI Crew Suite repos",
  "license": "Apache-2.0",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "automate-stale",
    "changeset",
    "ci",
    "codeql",
    "dependency-review-bypass",
    "dependency-review-check",
    "eslint-config-sync",
    "lint-architecture",
    "playwright-bypass",
    "playwright-run",
    "publish",
    "weekly-check-versions",
    "validate-branch"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{json,md,css,ts,js}\"",
    "lint": "lint:actions && lint:typescript",
    "lint:actions": "turbo lint:actions",
    "lint:typescript": "turbo lint:typescript",
    "sync": "crew sync:refs",
    "test": "yarn test:unit",
    "test:unit": "turbo test:unit",
    "test:unit:coverage": "turbo run test:unit:coverage",
    "typecheck": "turbo typecheck",
    "typecheck:full": "turbo typecheck --force",
    "version": "changeset version && yarn install"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "devDependencies": {
    "@changesets/cli": "catalog:dev",
    "@tsconfig/node24": "catalog:dev",
    "@types/node": "catalog:dev",
    "@typescript-eslint/eslint-plugin": "catalog:dev",
    "@typescript-eslint/parser": "catalog:dev",
    "eslint": "catalog:dev",
    "husky": "catalog:dev",
    "lint-staged": "catalog:dev",
    "prettier": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
