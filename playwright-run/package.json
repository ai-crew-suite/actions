{
  "name": "@ai-crew-suite/action-playwright",
  "description": "GitHub Action to run Playwright tests",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ncc build src/main.ts -o dist --source-map --license third-party-licenses.txt",
    "clean": "rm -rf dist third-party-licenses.txt",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"package.json\"",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/core": "catalog:prod:",
    "@actions/github": "catalog:prod:"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@vercel/ncc": "catalog:dev",
    "eslint": "catalog:dev",
    "prettier": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
